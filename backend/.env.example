# ---- General --------------------------------------------------------------
ENV=dev
DEBUG=true
BASE_CURRENCY=IRR
ALLOWED_ORIGINS=http://localhost:3000

# ---- Security (CHANGE THESE IN PRODUCTION) --------------------------------
SECRET_KEY=change-me-to-a-long-random-value-at-least-32-chars
ACCESS_TOKEN_TTL_MINUTES=30
REFRESH_TOKEN_TTL_MINUTES=10080
MAX_LOGIN_ATTEMPTS=5
LOCKOUT_MINUTES=15
RATE_LIMIT_PER_MINUTE=240
KEYSTORE_DIR=./.keystore

# ---- Database -------------------------------------------------------------
DATABASE_URL=sqlite:///./gozaresh.db
# DATABASE_URL=postgresql+psycopg://gozaresh:password@localhost:5432/gozaresh

# ---- FX rates -------------------------------------------------------------
# true  = deterministic offline fixtures (no outbound calls; good for demos/CI)
# false = live central-bank feed with exchange-API fallback
FX_OFFLINE_MODE=true
FX_CENTRAL_BANK_URL=https://api.example-cbi.ir/v1/rates
FX_EXCHANGE_API_URL=https://api.exchangerate.host/latest
FX_CACHE_TTL_SECONDS=300

# ---- Calculation SLA ------------------------------------------------------
DECIMAL_PLACES=16
CALC_SLA_MS=50

# ---- Notifications --------------------------------------------------------
NOTIFICATIONS_DRY_RUN=true
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@gozaresh-demo.com
SMS_PROVIDER_URL=https://api.example-sms.ir/v1/send
SMS_API_KEY=

# ---- Integrations ---------------------------------------------------------
INTEGRATIONS_SANDBOX=true
MOADIAN_BASE_URL=https://tp.tax.gov.ir/req/api/self-tsp
MOADIAN_MEMORY_ID=DEMO-MEMORY-ID
MOADIAN_ECONOMIC_CODE=DEMO-ECONOMIC-CODE
BANK_GATEWAY_URL=https://api.example-bank.ir/v1
BANK_TERMINAL_ID=DEMO-TERMINAL

# ---- Alerting -------------------------------------------------------------
ENABLE_BACKGROUND_SCHEDULER=true
ALERT_SCAN_INTERVAL_SECONDS=60
ANOMALY_ZSCORE_THRESHOLD=3.0
